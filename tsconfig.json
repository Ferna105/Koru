{
  "extends": "@react-native/typescript-config/tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    /* true (default de RN): los .d.ts del ecosistema 0.81 no chequean limpio
       entre sí y ahogaban los errores del código propio. */
    "skipLibCheck": true,
    "jsx": "react",
    "paths": {
      "*": [
        "src/*",
      ],
      "tests": [
        "tests/*",
      ],
      "components/*": [
        "src/components/*",
      ],
    },
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods"]
}
